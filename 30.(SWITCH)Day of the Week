#include <stdio.h>

int main()
{
    int day;
    scanf("%d",&day);
    switch(day){
        case 1:
        printf("Sunday",1);
        break;
        case 2:
        printf("Monday",2);
        break;
        case 3:
        printf("Tuesday",3);
        break;
        case 4:
        printf("Wednesday",4);
        break;
        case 5:
        printf("Thursday",5);
        break;
        case 6:
        printf("Friday",6);
        break;
        case 7:
        printf("Saturday",7);
        break;
        default:
        printf("Invalid Choice!");
    }
    
    return 0;
    
}
