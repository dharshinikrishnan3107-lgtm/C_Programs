#include <stdio.h>

int main()
{
    int a,b;
    char op;
    scanf("%d%d", &a,&b);
    printf("Enter the Operator (+,-,*,/,%): ");
    scanf(" %c", &op);
    switch(op)
    {
        case'+':
        printf("Result=%d",a+b);
        break;
        case'-':
        printf("Result=%d",a-b);
        break;
        case'*':
        printf("Result=%d",a*b);
        break;
        case'/':
        printf("Result=%d",a/b);
        break;
        case'%':
        printf("Result=%d",a%b);
        break;
        default:
        printf("Invalid Operator!");
        
    }
    return 0;
}
