#include <stdio.h>

int main()
{
    int a,b,choice;
    scanf("%d%d%d",&a,&b,&choice);
    switch(choice){
        case 1:
        printf("1.Circle:%d\n",a*b*b);
        break;
        case 2:
        printf("2.Rectangle:%d\n",a*b);
        break;
        case 3:
        printf("3.Triangle:%d\n",1/2 * a*b);
        break;
        case 4:
        printf("4.Square:%d\n",a*a);
        break;
    }

    return 0;
}
