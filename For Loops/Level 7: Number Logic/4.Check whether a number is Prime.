Prime Number

A number greater than 1 with exactly two factors: 1 and itself.

Examples: 2, 3, 5, 7, 11, 13



#include <stdio.h>

int main()
{
    int num,i,divisor=0;
    scanf("%d",&num);
    for(i=1;i<=num;i++){
        if(num%i==0){
            divisor++;
        }
    }
    if(divisor==2){
        printf("Prime Number");
    }else(printf("Not a Prime Number"));
    return 0;
}


